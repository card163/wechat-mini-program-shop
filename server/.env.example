# 应用
APP_DEBUG=true
APP_NAME=nice-fold
APP_URL=http://127.0.0.1:8787
LISTEN=http://0.0.0.0:8787

# 数据库
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nf-shop
DB_USERNAME=root
DB_PASSWORD=
DB_PREFIX=

# JWT（会员端 / 管理端使用不同密钥，禁止提交真实值到仓库）
JWT_MEMBER_SECRET=
JWT_MEMBER_TTL=604800
JWT_ADMIN_SECRET=
JWT_ADMIN_TTL=43200

# 微信小程序
WECHAT_APPID=
WECHAT_SECRET=

# 微信支付（V3，公钥模式）
WECHAT_PAY_MCH_ID=
# 商户API证书序列号（不是微信支付公钥ID！需先申请商户API证书后用 openssl x509 -in apiclient_cert.pem -noout -serial 读取）
WECHAT_PAY_SERIAL_NO=
# APIv3 密钥（32位，自定义，在商户平台“解密回调”处设置）
WECHAT_PAY_API_V3_KEY=
# 微信支付公钥文件路径（商户平台下载的 pub_key.pem），用于校验回调/应答签名
WECHAT_PAY_CERT_PATH=
# 商户私钥 apiclient_key.pem 路径（申请商户API证书时一并生成），用于请求签名
WECHAT_PAY_KEY_PATH=
WECHAT_PAY_NOTIFY_URL=
