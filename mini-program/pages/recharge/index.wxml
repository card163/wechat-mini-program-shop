<view class="container">
  <view class="card">
    <view class="title" style="margin-bottom:20rpx;">充值活动</view>
    <view class="pkg-grid">
      <view
        wx:for="{{packages}}"
        wx:key="id"
        class="pkg {{selectedId === item.id ? 'active' : ''}}"
        data-id="{{item.id}}"
        bindtap="onSelect"
      >
        <view class="pkg-amount">¥{{item.amountText}}</view>
        <view class="pkg-reward" wx:if="{{item.gift_amount > 0}}">赠 ¥{{item.giftText}} 赠金</view>
        <view class="pkg-reward" wx:if="{{item.gift_point > 0}}">赠 {{item.gift_point}} 积分</view>
      </view>
    </view>
  </view>
</view>

<view class="footer">
  <view class="sub footer-tip">支付后到账，余额充值可至「我的」查看</view>
  <view class="btn-primary submit" bindtap="submit">微信支付</view>
</view>

