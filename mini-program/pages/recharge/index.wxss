.container { padding-bottom: 180rpx; }

.pkg-grid { display: flex; flex-wrap: wrap; gap: 20rpx; }
.pkg {
  width: calc(50% - 10rpx);
  box-sizing: border-box;
  border: 1rpx solid rgba(212,175,55,.3);
  border-radius: 16rpx;
  padding: 32rpx 12rpx;
  text-align: center;
  background: var(--bg-card-2);
}
.pkg.active { border-color: var(--accent); background: rgba(212,175,55,.08); }
.pkg-amount { font-size: 40rpx; font-weight: 700; color: var(--text); margin-bottom: 10rpx; }
.pkg-reward { color: var(--accent); font-size: 24rpx; }

.footer {
  position: fixed; left: 0; right: 0; bottom: 0;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #1a1a1a;
  border-top: 1rpx solid var(--line);
}
.footer-tip { text-align: center; margin-bottom: 16rpx; }
.submit { width: 100%; height: 84rpx; line-height: 84rpx; text-align: center; background: #d2574f; font-size: 30rpx; }
