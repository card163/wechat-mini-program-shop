.tabs {
  display: flex; background: #1a1a1a;
  position: sticky; top: 0; z-index: 10;
  border-bottom: 1rpx solid var(--line);
}
.tab { flex: 1; text-align: center; padding: 26rpx 0; font-size: 26rpx; color: var(--text-sub); }
.tab.active { color: var(--accent); border-bottom: 4rpx solid var(--accent); }

.goods { padding: 10rpx 0; }
.goods-price { margin-left: 20rpx; }

.actions { display: flex; justify-content: flex-end; margin-top: 20rpx; }
.act { width: 180rpx; height: 64rpx; line-height: 64rpx; font-size: 26rpx; margin-left: 20rpx; }

.more { text-align: center; padding: 24rpx 0; }
