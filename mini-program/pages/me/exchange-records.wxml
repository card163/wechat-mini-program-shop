<view class="container">
  <view wx:if="{{!loading && !list.length}}" class="empty">暂无兑换记录</view>

  <view wx:for="{{list}}" wx:key="id" class="card">
    <view class="row-between">
      <view class="title">{{item.goods_name}}</view>
      <view class="tag">{{item.status_text}}</view>
    </view>
    <view class="divider" />
    <view class="row-between">
      <view class="sub">消耗 {{item.point}} 记分牌</view>
      <view class="sub" wx:if="{{item.gift_amount > 0}}">到账赠金 ¥{{item.giftText}}</view>
    </view>
    <view class="sub">{{item.record_no}}</view>
    <view class="sub">{{item.created_at}}</view>

    <view class="actions" wx:if="{{item.status === 0}}">
      <button class="btn-primary act" data-id="{{item.id}}" bindtap="showCode">出示兑换码</button>
    </view>
  </view>
</view>

<view class="mask" wx:if="{{codeRecord}}" bindtap="closeCode">
  <view class="code-box" catchtap="noop">
    <view class="title">{{codeRecord.goods_name}}</view>
    <view class="sub">请出示给店员核销</view>
    <view class="code">{{codeRecord.record_no}}</view>
    <view class="sub">核销后不可撤销</view>
  </view>
</view>
