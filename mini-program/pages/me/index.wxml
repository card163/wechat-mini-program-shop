<view class="me-page" wx:if="{{member}}">
  <view class="profile-row">
    <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
      <image class="avatar" src="{{member.avatar}}" mode="aspectFill" />
    </button>
    <view class="flex-1 profile-info">
      <input
        class="nickname"
        type="nickname"
        value="{{member.nickname}}"
        placeholder="点击设置昵称"
        placeholder-class="sub"
        bindblur="onNicknameChange"
      />
      <view class="sub">ID:{{member.id}}</view>
    </view>
    <view class="wine-code-entry" bindtap="goWineCode">
      <image class="wine-code-icon" src="/assets/me/icon-qr.png" mode="aspectFit" />
      <view class="sub">存酒码</view>
    </view>
  </view>

  <view class="asset-card" bindtap="goRecharge">
    <view class="asset-badge">点击充值</view>
    <view class="asset-row">
      <view class="asset-item">
        <view class="asset-num">¥{{balanceText}}</view>
        <view class="sub">余额</view>
      </view>
      <view class="asset-sep"></view>
      <view class="asset-item">
        <view class="asset-num">{{member.point}}</view>
        <view class="sub">积分</view>
      </view>
      <view class="asset-sep"></view>
      <view class="asset-item">
        <view class="asset-num">¥{{giftText}}</view>
        <view class="sub">有效赠金</view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="section-title">常用功能</view>
    <view class="func-row">
      <view class="func-item" bindtap="goWine">
        <view class="func-icon"><image class="func-icon-img" src="/assets/me/icon-wine.png" mode="aspectFit" /></view>
        <view class="sub">我的存酒</view>
      </view>
      <view class="func-item" bindtap="openExchangeModal">
        <view class="func-icon"><image class="func-icon-img" src="/assets/me/icon-coin.png" mode="aspectFit" /></view>
        <view class="sub">取积分</view>
      </view>
      <view class="func-item" data-url="/pages/me/orders" bindtap="go">
        <view class="func-icon"><image class="func-icon-img" src="/assets/me/icon-doc.png" mode="aspectFit" /></view>
        <view class="sub">订单列表</view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="row-between">
      <view class="row shop-row">
        <view class="shop-logo">66</view>
        <view class="title" style="font-size:30rpx;">六六弗尔豪斯休闲酒馆</view>
      </view>
      <button class="contact-btn" open-type="contact">📞 联系我们</button>
    </view>
    <view class="service-text">
      尊敬的客户，您好：
      有任何疑问可直接联系我们客服电话/微信咨询，也可直接咨询我们现场服务人员。
    </view>
  </view>

  <view class="card">
    <view class="list-cell" data-url="/pages/me/point-logs" bindtap="go"><view class="flex-1">积分流水</view><view class="arrow">›</view></view>
    <view class="list-cell" data-url="/pages/me/gift-logs" bindtap="go"><view class="flex-1">赠金记录</view><view class="arrow">›</view></view>
  </view>
</view>

<view class="modal-mask" wx:if="{{exchangeVisible}}" bindtap="closeExchangeModal">
  <view class="modal-box" catchtap="noop">
    <view class="modal-close" bindtap="closeExchangeModal">✕</view>
    <view class="modal-title">取积分</view>
    <view class="exchange-tip">当前可用积分：{{member.point}}</view>
    <input
      class="modal-input"
      type="number"
      placeholder="请输入取积分数量"
      placeholder-class="sub"
      value="{{exchangePoint}}"
      bindinput="onExchangePointInput"
    />
    <view class="modal-actions">
      <view class="btn-ghost" bindtap="closeExchangeModal">取消</view>
      <view class="btn-gold" bindtap="confirmExchange">确认取积分</view>
    </view>
  </view>
</view>

