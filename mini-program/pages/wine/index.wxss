.wine-page { padding: 24rpx; }

.wine-header { margin-bottom: 20rpx; }
.page-title { font-size: 40rpx; font-weight: 700; }
.code-btn {
  background: linear-gradient(90deg, var(--primary), #c62c2c);
  color: #fff;
  padding: 14rpx 32rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.usage-title { color: var(--accent); font-size: 28rpx; font-weight: 700; margin-bottom: 12rpx; }
.usage-line { line-height: 40rpx; margin-bottom: 8rpx; }

.section-head { margin: 8rpx 0 20rpx; }
.section-title { font-size: 30rpx; font-weight: 700; }

.empty-wine { text-align: center; padding: 100rpx 0; }
.empty-emoji { font-size: 88rpx; margin-bottom: 20rpx; }
.empty-title { color: var(--text-sub); font-size: 30rpx; margin-bottom: 8rpx; }

.act { width: 160rpx; height: 60rpx; line-height: 60rpx; font-size: 24rpx; }

.takes-box { max-height: 900rpx; display: flex; flex-direction: column; }
.takes-scroll { max-height: 640rpx; }
.take-row { padding: 16rpx 0; border-bottom: 1rpx solid var(--line); }
.take-row:last-child { border-bottom: none; }
.btn-mini { height: 52rpx; line-height: 52rpx; padding: 0 20rpx; font-size: 22rpx; border-radius: 8rpx; text-align: center; }
