.code-card { text-align: center; padding: 48rpx 32rpx; }
.qrcode {
  width: 420rpx; height: 420rpx; margin: 32rpx auto;
  background: #fff; border-radius: 16rpx; padding: 16rpx;
}
.code-text {
  margin: 32rpx 0; padding: 32rpx 16rpx;
  background: #fff; color: #111; border-radius: 16rpx;
  font-size: 30rpx; word-break: break-all;
}
.warn { color: #e05b5b; }
.refresh { width: 320rpx; height: 76rpx; line-height: 76rpx; margin-top: 32rpx; }
.sub { line-height: 44rpx; }
