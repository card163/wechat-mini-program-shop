<view class="container">
  <view class="head">
    <view class="head-title accent">记分牌排行榜</view>
    <view class="sub">按累计获得记分牌排名</view>
  </view>

  <view class="card" wx:if="{{me}}">
    <view class="row">
      <view class="rank {{me.rank <= 3 && me.rank > 0 ? 'top' : ''}}">{{me.rank > 0 ? me.rank : '-'}}</view>
      <image class="avatar" src="{{me.avatar}}" mode="aspectFill" />
      <view class="flex-1">
        <view>{{me.nickname}}（我）</view>
        <view class="sub">{{me.rank > 0 ? '继续加油' : '暂未上榜'}}</view>
      </view>
      <view class="price">{{me.total_point}}</view>
    </view>
  </view>

  <view class="card">
    <view wx:if="{{!loading && !list.length}}" class="empty">暂无排名数据</view>
    <view wx:for="{{list}}" wx:key="member_id" class="row item">
      <view class="rank {{item.rank <= 3 ? 'top' : ''}}">{{item.rank}}</view>
      <image class="avatar" src="{{item.avatar}}" mode="aspectFill" />
      <view class="flex-1">{{item.nickname}}</view>
      <view class="price">{{item.total_point}}</view>
    </view>
  </view>
</view>
