.container { padding: 24rpx; padding-bottom: 160rpx; }

.section-label { font-size: 28rpx; color: var(--text-sub); margin: 24rpx 0 12rpx; }
.section-label:first-child { margin-top: 0; }

.select-box {
  display: flex; align-items: center; justify-content: space-between;
  background: var(--bg-card-2); border-radius: 12rpx;
  padding: 26rpx 24rpx; font-size: 30rpx;
}
.select-arrow { color: var(--text-sub); }

.pay-option {
  padding: 24rpx; margin-bottom: 16rpx;
  border-radius: 16rpx; background: var(--bg-card-2);
  border: 2rpx solid transparent;
}
.pay-option.active { border-color: #e05b5b; }
.pay-option.disabled { opacity: .5; }
.pay-name { font-size: 30rpx; font-weight: 700; }
.balance-option .sub { line-height: 40rpx; }
.warn { color: #e05b5b; }

.item-box { background: var(--bg-card-2); border-radius: 16rpx; padding: 8rpx 20rpx; }
.item-row { padding: 20rpx 0; border-bottom: 1rpx solid var(--line); }
.item-row:last-child { border-bottom: none; }
.item-img { width: 96rpx; height: 96rpx; border-radius: 12rpx; margin-right: 20rpx; background: #2a2a2a; }

.remark-box {
  width: 100%; min-height: 200rpx;
  background: var(--bg-card-2); border-radius: 16rpx;
  padding: 20rpx; font-size: 28rpx; color: var(--text);
}

.footer {
  position: fixed; left: 0; right: 0; bottom: 0;
  min-height: 120rpx; display: flex; align-items: center;
  padding: 0 24rpx env(safe-area-inset-bottom); background: #1a1a1a; border-top: 1rpx solid var(--line);
}
.price.big { font-size: 38rpx; }
.submit { width: 220rpx; height: 80rpx; line-height: 80rpx; text-align: center; background: #d2574f; }

.table-picker-box { width: 680rpx; max-height: 80vh; display: flex; flex-direction: column; }
.table-picker-scroll { flex: 1; max-height: 800rpx; }
.table-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.table-cell {
  width: calc((100% - 32rpx) / 3);
  padding: 22rpx 0; text-align: center;
  background: var(--bg-card); border: 1rpx solid var(--line); border-radius: 12rpx;
  color: var(--text-sub); font-size: 28rpx;
}
.table-cell.active { border-color: var(--accent); color: var(--accent); background: rgba(212, 175, 55, .12); }
.table-picker-confirm { margin-top: 28rpx; height: 76rpx; line-height: 76rpx; text-align: center; border-radius: 12rpx; font-size: 28rpx; }
