<view class="shop-header">
  <view class="shop-logo">66</view>
  <view class="shop-name flex-1">{{shop.name || '六六弗尔豪斯休闲酒馆'}}</view>
  <view class="shop-hours" wx:if="{{shop.business_hours}}">营业时间：{{shop.business_hours}}</view>
</view>

<view class="shop">
  <scroll-view class="side" scroll-y>
    <view
      wx:for="{{categories}}"
      wx:key="id"
      class="side-item {{currentCategory === item.id ? 'active' : ''}}"
      data-id="{{item.id}}"
      bindtap="onCategoryTap"
    >{{item.name}}</view>
  </scroll-view>

  <scroll-view class="list" scroll-y>
    <view wx:if="{{!loading && !goods.length}}" class="empty">暂无商品</view>

    <view wx:for="{{goods}}" wx:key="id" class="goods">
      <image class="goods-img" src="{{item.cover}}" mode="aspectFill" />
      <view class="goods-info">
        <view class="goods-name">{{item.name}}</view>
        <view class="sub goods-desc">{{item.subtitle}}</view>
        <view class="sub" wx:if="{{item.gift_payable === 0}}">不支持赠金支付</view>
        <view class="row-between goods-bottom">
          <view class="price">¥{{item.priceText}}</view>
          <view class="stepper">
            <view wx:if="{{item.quantity > 0}}" class="step-btn" data-id="{{item.id}}" bindtap="onMinus">-</view>
            <view wx:if="{{item.quantity > 0}}" class="step-num">{{item.quantity}}</view>
            <view class="step-btn add" data-id="{{item.id}}" bindtap="onAdd">+</view>
          </view>
        </view>
      </view>
    </view>
    <view class="list-bottom" />
  </scroll-view>
</view>

<view class="cart-bar">
  <view class="cart-info">
    <view class="price">¥{{cartAmountText}}</view>
    <view class="sub">共{{cartCount}}件</view>
  </view>
  <view class="cart-btn {{cartCount ? '' : 'disabled'}}" bindtap="goCheckout">去结算</view>
</view>

