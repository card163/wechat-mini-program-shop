<view class="container" wx:if="{{preview}}">
  <view class="section-label">下单桌号</view>
  <view class="select-box" bindtap="openTablePicker">
    <view class="{{tableName ? '' : 'sub'}}">{{tableName || '请选择'}}</view>
    <view class="select-arrow">↓</view>
  </view>

  <view class="section-label">支付方式</view>
  <view class="pay-option {{payType === 1 ? 'active' : ''}}" data-type="1" bindtap="onPayTypeChange">
    <view class="pay-name">微信支付</view>
    <view class="sub" wx:if="{{payType === 1 && comboConfirmed}}">
      已启用组合支付：{{giftLabel}}抵¥{{comboSummary.giftCashText}} + {{drinkCardLabel}}抵¥{{comboSummary.drinkCardCashText}}，微信实付 ¥{{comboSummary.wechatAmountText}}
    </view>
    <view class="sub" wx:elif="{{payType === 1 && preview.combo_pay.show}}">可尝试{{giftLabel}}/{{drinkCardLabel}}余额合并微信支付，点击选择</view>
  </view>
  <view
    class="pay-option balance-option {{payType === 2 ? 'active' : ''}} {{!preview.pay_options.balance.usable ? 'disabled' : ''}}"
    data-type="2"
    bindtap="onPayTypeChange"
  >
    <view class="pay-name">余额支付</view>
    <view class="sub">本金余额：¥{{preview.balanceText}}</view>
    <view class="sub warn" wx:if="{{!preview.pay_options.balance.usable}}">余额不足，请先充值</view>
  </view>
  <view
    class="pay-option balance-option {{payType === 3 ? 'active' : ''}} {{!preview.pay_options.gift.usable ? 'disabled' : ''}}"
    data-type="3"
    bindtap="onPayTypeChange"
  >
    <view class="pay-name">{{giftLabel}}支付</view>
    <view class="sub">{{giftLabel}}余额：{{preview.giftBalanceText}}</view>
    <view class="sub warn" wx:if="{{!preview.pay_options.gift.available}}">本单暂无法使用{{giftLabel}}支付</view>
    <view class="sub warn" wx:elif="{{!preview.pay_options.gift.usable}}">{{giftLabel}}余额不足，请先充值</view>
  </view>
  <view
    class="pay-option balance-option {{payType === 4 ? 'active' : ''}} {{!preview.pay_options.drink_card.usable ? 'disabled' : ''}}"
    data-type="4"
    bindtap="onPayTypeChange"
  >
    <view class="pay-name">{{drinkCardLabel}}支付</view>
    <view class="sub">{{drinkCardLabel}}余额：{{preview.drinkCardBalanceText}}</view>
    <view class="sub warn" wx:if="{{!preview.pay_options.drink_card.available}}">本单暂无法使用{{drinkCardLabel}}支付</view>
    <view class="sub warn" wx:elif="{{!preview.pay_options.drink_card.usable}}">{{drinkCardLabel}}余额不足，请先充值</view>
  </view>


  <view class="section-label">已选餐品</view>
  <view class="item-box">
    <view wx:for="{{preview.items}}" wx:key="goods_id" class="row item-row">
      <image class="item-img" src="{{item.goods_cover}}" mode="aspectFill" />
      <view class="flex-1">
        <view class="title" style="font-size:28rpx;">{{item.goods_name}}</view>
        <view class="price">¥{{item.priceText}}</view>
      </view>
      <view class="sub">×{{item.quantity}}</view>
    </view>
  </view>

  <view class="section-label">订单备注</view>
  <textarea class="remark-box" placeholder="请填写你的其他要求" placeholder-class="sub" bindinput="onRemarkInput" maxlength="200" />

  <view class="footer">
    <view class="flex-1">
      <text class="sub">合计: </text>
      <text class="price big">¥{{preview.totalText}}</text>
    </view>
    <view class="btn-primary submit" bindtap="submit">支付</view>
  </view>
</view>

<view class="modal-mask" wx:if="{{showTablePicker}}" bindtap="closeTablePicker">
  <view class="modal-box table-picker-box" catchtap="noop">
    <view class="modal-close" bindtap="closeTablePicker">✕</view>
    <view class="modal-title">选择桌位号</view>
    <scroll-view scroll-y class="table-picker-scroll">
      <block wx:for="{{zones}}" wx:key="zone_id" wx:for-item="zone">
        <view class="section-label zone-label">{{zone.zone_name}}</view>
        <view class="table-grid">
          <view
            wx:for="{{zone.tables}}"
            wx:key="id"
            wx:for-item="table"
            class="table-cell {{tempTableId === table.id ? 'active' : ''}}"
            data-zone-name="{{zone.zone_name}}"
            data-id="{{table.id}}"
            data-name="{{table.name}}"
            bindtap="onTableSelect"
          >{{table.name}}</view>
        </view>
      </block>
    </scroll-view>
    <view class="btn-gold table-picker-confirm" bindtap="confirmTablePicker">确定</view>
  </view>
</view>

<view class="modal-mask" wx:if="{{comboModalVisible}}" bindtap="closeComboModal">
  <view class="modal-box" catchtap="noop">
    <view class="modal-close" bindtap="closeComboModal">✕</view>
    <view class="modal-title">组合支付</view>
    <view class="sub" style="margin-bottom: 20rpx;">
      您的{{giftLabel}}/{{drinkCardLabel}}余额不足以单独支付整单，可选择合并抵扣，不足部分仍由微信支付
    </view>
    <view class="combo-row {{comboTempUseGift ? 'active' : ''}}" bindtap="onToggleComboGift">
      <view>{{comboTempUseGift ? '✓' : ''}} 使用{{giftLabel}}余额</view>
      <view class="price">可抵¥{{comboPreview.giftCashText}}</view>
    </view>
    <view class="combo-row {{comboTempUseDrinkCard ? 'active' : ''}}" bindtap="onToggleComboDrinkCard">
      <view>{{comboTempUseDrinkCard ? '✓' : ''}} 使用{{drinkCardLabel}}余额</view>
      <view class="price">可抵¥{{comboPreview.drinkCardCashText}}</view>
    </view>
    <view class="combo-summary">微信需支付：¥{{comboPreview.wechatAmountText}}</view>
    <view class="modal-actions">
      <view class="btn-ghost" bindtap="useWechatOnly">仅微信支付</view>
      <view class="btn-gold" bindtap="confirmCombo">确认组合支付</view>
    </view>
  </view>
</view>

