.shop-header {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  gap: 16rpx;
  border-bottom: 1rpx solid var(--line);
}
.shop-logo {
  width: 64rpx; height: 64rpx; border-radius: 12rpx;
  background: #1a1a1a; color: var(--text);
  display: flex; align-items: center; justify-content: center;
  font-size: 20rpx; font-weight: 700; flex: none;
}
.shop-name { font-size: 30rpx; font-weight: 700; }
.shop-hours { font-size: 22rpx; color: var(--text-sub); flex: none; }

.shop { display: flex; height: calc(100vh - 96rpx - 130rpx - env(safe-area-inset-bottom)); }

.side { width: 176rpx; background: #171717; flex: none; }
.side-item {
  padding: 28rpx 12rpx;
  text-align: center;
  font-size: 26rpx;
  line-height: 36rpx;
  color: var(--text-sub);
}
.side-item.active {
  color: var(--text);
  font-weight: 700;
  background: #0d0d0d;
}

.list { flex: 1; padding: 20rpx; }
.list-bottom { height: 40rpx; }

.goods { display: flex; padding: 20rpx 0; border-bottom: 1rpx solid var(--line); }
.goods-img { width: 160rpx; height: 160rpx; border-radius: 12rpx; background: #2a2a2a; flex: none; }
.goods-info { flex: 1; margin-left: 20rpx; display: flex; flex-direction: column; min-width: 0; }
.goods-name { font-size: 30rpx; font-weight: 700; margin-bottom: 6rpx; }
.goods-desc { line-height: 36rpx; margin-bottom: 6rpx; }
.goods-bottom { margin-top: auto; }

.stepper { display: flex; align-items: center; gap: 16rpx; }
.step-btn {
  width: 48rpx; height: 48rpx; line-height: 46rpx; text-align: center;
  border-radius: 50%; background: #3a3a3a; color: var(--text); font-size: 30rpx;
}
.step-btn.add { background: #3a3a3a; }
.step-num { min-width: 40rpx; text-align: center; font-size: 28rpx; }

.cart-bar {
  position: fixed; left: 0; right: 0; bottom: 0;
  min-height: 110rpx; display: flex; align-items: center;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom)); background: #1a1a1a; border-top: 1rpx solid var(--line);
}
.cart-info { flex: 1; }
.cart-btn {
  padding: 0 56rpx; height: 76rpx; line-height: 76rpx;
  border-radius: 999rpx; background: #d2574f; color: #fff; font-size: 28rpx; font-weight: 600;
}
.cart-btn.disabled { opacity: .5; }

.cart-box { width: 680rpx; max-height: 80vh; display: flex; flex-direction: column; }
.cart-list-scroll { flex: 1; max-height: 700rpx; }
.cart-row { display: flex; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid var(--line); }
.cart-row:last-child { border-bottom: none; }
.cart-row-img { width: 96rpx; height: 96rpx; border-radius: 12rpx; background: #2a2a2a; flex: none; }
.cart-row-info { flex: 1; margin: 0 20rpx; min-width: 0; }
.cart-row-name { font-size: 28rpx; margin-bottom: 8rpx; }

/* 商品详情底部抽屉 */
.drawer-mask {
  position: fixed; inset: 0; background: rgba(0, 0, 0, .65);
  display: flex; align-items: flex-end; z-index: 999;
}
.drawer-box {
  width: 100%; max-height: 85vh; display: flex; flex-direction: column;
  background: var(--bg-card-2); border-radius: 24rpx 24rpx 0 0;
  padding: 16rpx 0 0;
}
.drawer-handle { width: 72rpx; height: 8rpx; border-radius: 4rpx; background: var(--line); margin: 0 auto 12rpx; }
.drawer-loading { padding: 80rpx 0; text-align: center; color: var(--text-sub); }
.drawer-scroll { flex: 1; overflow: hidden; }
.drawer-cover { width: 100%; height: 360rpx; background: #2a2a2a; }
.drawer-body { padding: 24rpx 32rpx; }
.drawer-name { font-size: 34rpx; font-weight: 700; margin-bottom: 8rpx; }
.drawer-price-row { margin: 16rpx 0; }
.strike { text-decoration: line-through; margin-left: 12rpx; }
.drawer-tags { display: flex; flex-direction: column; gap: 12rpx; margin: 16rpx 0; }
.drawer-tag {
  font-size: 24rpx; color: var(--accent); padding: 14rpx 20rpx;
  border-radius: 10rpx; background: rgba(212, 175, 55, .1);
}
.drawer-tag.off { color: var(--text-sub); background: rgba(255, 255, 255, .04); }
.drawer-tag.gift { color: #d2574f; background: rgba(210, 87, 79, .1); }
.drawer-desc { font-size: 26rpx; color: var(--text-sub); line-height: 44rpx; white-space: pre-wrap; }

.drawer-footer {
  flex: none; display: flex; align-items: center; justify-content: space-between;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--line);
}

