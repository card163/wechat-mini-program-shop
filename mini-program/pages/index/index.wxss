.home {
  min-height: 100vh;
  background: #0d0d0d;
  padding: 24rpx 0 200rpx;
  position: relative;
  overflow: hidden;
}

.top-bar { display: flex; justify-content: flex-end; padding: 0 24rpx; }
.notice-btn {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(255,255,255,.08);
  color: var(--text);
  font-size: 24rpx;
}

.brand { text-align: center; margin-top: 24rpx; padding: 0 24rpx; }
.brand-logo {
  font-size: 64rpx;
  font-weight: 700;
  font-style: italic;
  color: var(--accent);
  letter-spacing: 1rpx;
  text-shadow: 0 2rpx 12rpx rgba(212,175,55,.35);
}
.marquee {
  display: inline-block;
  margin-top: 20rpx;
  padding: 10rpx 24rpx;
  border: 1rpx solid rgba(212,175,55,.5);
  border-radius: 999rpx;
  color: var(--accent);
  font-size: 24rpx;
  font-style: italic;
  background: rgba(212,175,55,.06);
}

.emblem-bg {
  display: block;
  width: 100%;
  margin-top: 24rpx;
}

.entry-panel {
  position: relative;
  display: flex;
  margin: -104rpx 24rpx 0;
  background: linear-gradient(180deg, rgba(28,26,24,.78), rgba(18,17,16,.88));
  border: 1rpx solid rgba(212,175,55,.4);
  border-radius: 32rpx;
  padding: 48rpx 0 40rpx;
  box-shadow: inset 0 1rpx 0 rgba(255,220,150,.25), 0 20rpx 40rpx rgba(0,0,0,.35);
}
.entry-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}
.entry-icon { width: 76rpx; height: 76rpx; }
.entry-label { color: var(--accent); font-size: 30rpx; font-weight: 600; }

.lower-bg {
  display: block;
  width: 100%;
  margin-top: -20rpx;
}

.notice-body { line-height: 44rpx; white-space: pre-wrap; }
