.hero {
  padding: 40rpx 8rpx 32rpx;
}
.hero-name {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: var(--accent);
  margin-bottom: 12rpx;
}

.banner { height: 280rpx; border-radius: 20rpx; overflow: hidden; margin-bottom: 24rpx; }
.banner-img { width: 100%; height: 280rpx; }

.asset { display: flex; }
.asset-item { flex: 1; text-align: center; }
.asset-num { font-size: 40rpx; font-weight: 700; margin-bottom: 8rpx; }

.grid { display: flex; flex-wrap: wrap; }
.grid-item {
  width: 25%;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-sub);
  margin-bottom: 24rpx;
}
.grid-icon {
  width: 88rpx;
  height: 88rpx;
  line-height: 88rpx;
  margin: 0 auto 12rpx;
  border-radius: 24rpx;
  background: rgba(139, 26, 26, .25);
  color: var(--accent);
  font-size: 32rpx;
}
