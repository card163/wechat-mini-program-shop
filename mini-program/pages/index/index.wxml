<view class="home">
  <view class="top-bar">
    <view class="notice-btn" bindtap="showNotice">本店须知</view>
  </view>

  <view class="brand">
    <view class="brand-logo">六六弗尔豪斯休闲酒馆</view>
    <view class="marquee">📢 绿色竞技，禁止赌博</view>
  </view>

  <image class="emblem-bg" src="/assets/home/bg-emblem.jpg" mode="widthFix" />

  <view class="entry-panel">
    <view class="entry-item" bindtap="goShop">
      <image class="entry-icon" src="/assets/home/order.png" mode="aspectFit" />
      <view class="entry-label">点餐</view>
    </view>
    <view class="entry-item" bindtap="goRecharge">
      <image class="entry-icon" src="/assets/home/recharge.png" mode="aspectFit" />
      <view class="entry-label">充值/套餐</view>
    </view>
  </view>

  <image class="lower-bg" src="/assets/home/bg-lower.jpg" mode="widthFix" />
</view>

<view class="modal-mask" wx:if="{{noticeVisible}}" bindtap="hideNotice">
  <view class="modal-box" catchtap="noop">
    <view class="modal-close" bindtap="hideNotice">✕</view>
    <view class="modal-title">本店须知</view>
    <view class="sub notice-body">{{shop.notice || '尊敬的客户，您好：欢迎光临 六六弗尔豪斯休闲酒馆，请理性消费，绿色竞技，禁止赌博。'}}</view>
  </view>
</view>
