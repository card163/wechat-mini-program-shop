/* 全局主题变量与基础样式，颜色取自设计稿：近黑背景 + 暗红主色 + 金黄强调色 */
page {
  --bg: #121212;
  --bg-card: #1c1c1e;
  --bg-card-2: #242427;
  --primary: #8b1a1a;
  --accent: #d4af37;
  --text: #f5f5f5;
  --text-sub: #9a9a9a;
  --line: #2c2c2e;

  background: var(--bg);
  color: var(--text);
  font-size: 28rpx;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
}

view, text, input, button, scroll-view { box-sizing: border-box; }

.container { padding: 24rpx; }

.card {
  background: var(--bg-card);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.row { display: flex; align-items: center; }
.row-between { display: flex; align-items: center; justify-content: space-between; }
.flex-1 { flex: 1; }

.title { font-size: 34rpx; font-weight: 600; }
.sub { color: var(--text-sub); font-size: 24rpx; }
.accent { color: var(--accent); }
.price { color: var(--accent); font-weight: 600; }

.btn-primary {
  background: linear-gradient(90deg, #8b1a1a, #b32626);
  color: #fff;
  border-radius: 999rpx;
  font-size: 30rpx;
  border: none;
}
.btn-primary[disabled] { opacity: .5; }

.btn-ghost {
  background: transparent;
  color: var(--accent);
  border: 1rpx solid var(--accent);
  border-radius: 999rpx;
  font-size: 26rpx;
}

.divider { height: 1rpx; background: var(--line); margin: 20rpx 0; }

.empty {
  padding: 120rpx 0;
  text-align: center;
  color: var(--text-sub);
  font-size: 26rpx;
}

.tag {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  background: rgba(212, 175, 55, .16);
  color: var(--accent);
}
