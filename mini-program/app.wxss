/* 全局主题变量与基础样式，颜色取自设计稿：近黑背景 + 暗红主色 + 金黄强调色 */
page {
  --bg: #121212;
  --bg-card: #1c1c1e;
  --bg-card-2: #242427;
  --primary: #8b1a1a;
  --accent: #d4af37;
  --text: #f5f5f5;
  --text-sub: #9a9a9a;
  --line: #2c2c2e;

  background: var(--bg);
  color: var(--text);
  font-size: 28rpx;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
}

view, text, input, button, scroll-view { box-sizing: border-box; }

.container { padding: 24rpx; }

.card {
  background: var(--bg-card);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.row { display: flex; align-items: center; }
.row-between { display: flex; align-items: center; justify-content: space-between; }
.flex-1 { flex: 1; }

.title { font-size: 34rpx; font-weight: 600; }
.sub { color: var(--text-sub); font-size: 24rpx; }
.accent { color: var(--accent); }
.price { color: var(--accent); font-weight: 600; }

.btn-primary {
  background: linear-gradient(90deg, #8b1a1a, #b32626);
  color: #fff;
  border-radius: 999rpx;
  font-size: 30rpx;
  border: none;
}
.btn-primary[disabled] { opacity: .5; }

.btn-ghost {
  background: transparent;
  color: var(--accent);
  border: 1rpx solid var(--accent);
  border-radius: 999rpx;
  font-size: 26rpx;
}

.divider { height: 1rpx; background: var(--line); margin: 20rpx 0; }

.empty {
  padding: 120rpx 0;
  text-align: center;
  color: var(--text-sub);
  font-size: 26rpx;
}

.tag {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  background: rgba(212, 175, 55, .16);
  color: var(--accent);
}

/* 金色描边卡片，用于赠金说明等强调区块 */
.card-gold {
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(212, 175, 55, .45);
  background: linear-gradient(160deg, rgba(212,175,55,.12), rgba(28,28,30,.6));
}

/* 通用居中弹窗遮罩 */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, .65);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}
.modal-box {
  width: 620rpx;
  background: var(--bg-card-2);
  border-radius: 20rpx;
  padding: 36rpx 32rpx;
  position: relative;
}
.modal-close {
  position: absolute;
  right: 20rpx;
  top: 16rpx;
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(255,255,255,.08);
  color: var(--text);
  font-size: 28rpx;
}
.modal-title {
  text-align: center;
  color: var(--accent);
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}
.modal-input {
  width: 100%;
  height: 76rpx;
  border: 1rpx solid var(--accent);
  border-radius: 12rpx;
  padding: 0 20rpx;
  color: var(--text);
  font-size: 28rpx;
}
.modal-actions { display: flex; gap: 16rpx; margin-top: 24rpx; }
.modal-actions .btn-ghost,
.modal-actions .btn-gold { flex: 1; height: 76rpx; line-height: 76rpx; text-align: center; border-radius: 12rpx; font-size: 28rpx; }
.btn-gold { background: var(--accent); color: #201a06; font-weight: 600; }

.qrcode-box {
  width: 100%;
  aspect-ratio: 1 / 1;
  background: #fff;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 24rpx;
  text-align: center;
  margin: 12rpx 0;
}
.qrcode-img { width: 100%; aspect-ratio: 1 / 1; border-radius: 12rpx; margin: 12rpx 0; background: #fff; }
.store-caption { text-align: center; color: var(--accent); font-size: 28rpx; font-weight: 600; margin-top: 16rpx; }

.tag {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  background: rgba(212, 175, 55, .16);
  color: var(--accent);
}
